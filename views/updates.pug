extends layout

block content
  .page-header
    h1 Add Time Entry
    p.subtitle Log a new time tracking record to HubSpot

  .card
    form(action="/update-cobj", method="POST")
      .form-group
        label(for="hours_spent") Hours Spent
        input(type="number", id="hours_spent", name="hours_spent", placeholder="e.g. 5", min="0", step="0.25", required)
        span.hint Enter the number of hours worked

      .form-group
        label(for="task") Task Name
        input(type="string", id="task", name="task", required)
        span.hint Enter the name of the task performed

      .form-actions
        a.btn.btn-secondary(href="/") Cancel
        button.btn.btn-primary(type="submit") Add Entry
