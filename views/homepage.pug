extends layout

block content
  .page-header
    h1 Time Tracking Dashboard
    p.subtitle Showing your most recent time entries
    a.btn.btn-primary(href="/update-cobj") + Add New Entry

  if data && data.length > 0
    .table-wrapper
      table
        thead
          tr
            th Task
            th Hours Spent
            th Billable Rate
            th Billable Amount
        tbody
          each record in data
            tr
              td
                if record.properties.time_logged
                  | #{new Date(parseInt(record.properties.time_logged)).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                else
                  span.muted —
              td
                if record.properties.hours_spent
                  | #{record.properties.hours_spent}h
                else
                  span.muted —
              td
                if record.properties.billable_rate
                  | $#{parseFloat(record.properties.billable_rate).toFixed(2)}
                else
                  span.muted —
              td
                if record.properties.billable_amount
                  | $#{parseFloat(record.properties.billable_amount).toFixed(2)}
                else
                  span.muted —
    .record-count #{data.length} record#{data.length !== 1 ? 's' : ''} found
  else
    .empty-state
      svg(width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round")
        rect(x="3" y="4" width="18" height="18" rx="2" ry="2")
        line(x1="16" y1="2" x2="16" y2="6")
        line(x1="8" y1="2" x2="8" y2="6")
        line(x1="3" y1="10" x2="21" y2="10")
      h3 No time entries yet
      p Start tracking your time by adding your first entry.
      a.btn.btn-primary(href="/update-cobj") Add Your First Entry
